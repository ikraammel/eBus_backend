# Copier vers .env.remote et renseigner les valeurs sur le poste uniquement.
# Utiliser l'adresse PostgreSQL EXTERNE accessible depuis votre PC.
DB_URL=jdbc:postgresql://DB_HOST:5432/DB_NAME?sslmode=require
DB_USERNAME=REPLACE_ME
DB_PASSWORD=REPLACE_ME
JWT_SECRET=REPLACE_WITH_BASE64_SECRET
MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=REPLACE_ME
STRIPE_SECRET_KEY=REPLACE_ME
STRIPE_WEBHOOK_SECRET=REPLACE_ME
PORT=8080
# Conserver le schema existant de la base distante au demarrage.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
